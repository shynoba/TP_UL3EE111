clear all ; 

%% Partie 1.1 Définition du système G(p) sous Matlab


p = tf('p');

%Déclaration des constantes

%Q3
k1=0.02; %°C/sV
tau1=2000; %s

G = k1/(p*(1+tau1*p));

% Partie 1.2 : Analyse du système G(p)

%Q4
p1 = pole(G);
z1 = zero(G);

% Le système possède 2 poles : [0; 5e-04] et aucun zéro, donc le système est instable car on a un pole positif : 5e-04 >0

%Q5
gain = dcgain(G);
% en G(0) le gain est infini, si on alimente le four en continu et en
% boucle ouverte à une tension v(t) = 6V 



%Alimenter le four avec 6V revient Entree V(t)=6*u(t) avec u(t) la fonction echelon unitaire
%Si on alimente le four avec entrée 




%Q6
figure(1);
step(6*G);
grid on;

title('Réponse indicielle de G(p) pour une entrée echelon avec amplitude 6V');
xlabel('Temps');
ylabel('Augmentation de température');


%% Partie 1.3 :
% Utilisation d'un capteur de température et analyse de fonction H(p)
p = tf('p');
%déclaration de constante
tau2=2; %s
K2=5e-3; %V/°C

%Q7

H=K2/(1+tau2*p);

%Q8

p2 = pole(H);
z2 = zero(H);
%Il y a un pôle réel négatif p0=-0.5, le système est donc stable

%Q9

figure(2);
step(H);
grid on;

title('réponse indicielle de H(p)');
xlabel('Temps');
ylabel('Température')

GainH = dcgain(H);
%=0.005


%Le temps de réponse à 5%
%d'un système du premier ordre vaut approximativement 3*tau, dans notre
%cas tr5% de H est de 6s On le vérifie graphiquement

